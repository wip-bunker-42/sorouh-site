# مشروع Sanity الخاص بالعميل. production هي مجموعة البيانات الوحيدة لهذا الموقع.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# الدومين الأساسي للعميل، دون شرطة مائلة أخيرة.
PUBLIC_SITE_ORIGIN=https://sorouh.site

# معرّف حاوية Google Tag Manager العامة للموقع.
PUBLIC_GTM_ID=GTM-MPNKM8RR

# للتطوير والاختبارات فقط؛ لا تضبطه في بناء الإنتاج.
CONTENT_FIXTURE_PATH=
