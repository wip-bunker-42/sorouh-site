---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContentImage from '../components/ContentImage.astro'
import PortableContent from '../components/PortableContent.astro'
import ContactActions from '../components/ContactActions.astro'
import { loadSnapshot } from '../lib/content/load-snapshot'
const data = loadSnapshot(),
  page = data.aboutPage
---

<BaseLayout
  title={page.seo.metaTitle}
  description={page.seo.metaDescription}
  path="/من-نحن/"
  breadcrumbs={[{ label: 'من نحن' }]}
  ><section class="page-hero">
    <div class="container">
      <p class="eyebrow">شركة صروح الشرقية للمقاولات</p><h1>{page.title}</h1><p class="lead">
        {page.lead}
      </p>
    </div>
  </section><section class="section">
    <div class="container about-grid">
      <div>
        <PortableContent value={page.body} /><ContactActions
          primary={data.siteSettings.primaryPhone}
          location="about"
          light
        />
      </div><ContentImage image={page.image} width={960} ratio={4 / 5} />
    </div>
  </section><section class="section-sm values">
    <div class="container">
      <p class="eyebrow">منهجية العمل</p><h2>أربع قواعد تحكم التنفيذ</h2><div class="grid grid-2">
        {
          page.values.map((item: any, index: number) => (
            <article>
              <>
                <span>0{index + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section></BaseLayout
>
<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: center;
    gap: 5rem;
  }
  .about-grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .values {
    background: #ede8e0;
  }
  .values article {
    padding: 2rem;
    background: white;
    border-top: 4px solid var(--copper);
  }
  .values span {
    color: var(--copper);
    font-weight: 900;
  }
  .values h3 {
    font-size: 1.5rem;
  }
  .values p {
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
