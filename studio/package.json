{
  "name": "@sorouh/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "check": "pnpm check:types && pnpm check:schema && pnpm test",
    "check:types": "tsc --noEmit",
    "check:schema": "sanity schemas validate",
    "test": "vitest run",
    "typegen": "sanity schemas extract --enforce-required-fields --path ../web/src/sanity/schema.json --force && sanity typegen generate --config-path schema-typegen.json",
    "deploy": "sanity deploy"
  },
  "dependencies": {
    "@sanity/client": "8.0.0",
    "@sanity/icons": "5.2.1",
    "@sanity/ui": "3.5.3",
    "@sanity/vision": "6.9.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.9.2",
    "styled-components": "6.5.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
