{
  "name": "sorouh-contractor-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preflight": "tsx scripts/preflight.ts",
    "dev": "pnpm --parallel --filter @sorouh/web --filter @sorouh/studio dev",
    "build": "pnpm preflight && pnpm --filter @sorouh/web build && pnpm --filter @sorouh/studio build",
    "check": "pnpm preflight && pnpm check:format && pnpm check:types && pnpm check:schema && pnpm test && pnpm test:build && pnpm validate:dist",
    "check:format": "prettier --check .",
    "check:types": "pnpm --filter @sorouh/web check:types && pnpm --filter @sorouh/studio check:types",
    "check:schema": "pnpm --filter @sorouh/studio check:schema && pnpm typegen && git diff --exit-code -- web/src/sanity/sanity.types.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @sorouh/web test:e2e",
    "test:build": "pnpm --filter @sorouh/web test:build",
    "validate:dist": "pnpm --filter @sorouh/web validate:dist",
    "verify:production": "tsx scripts/verify-production.ts",
    "seo:validate-targets": "tsx scripts/validate-seo-keyword-targets.ts",
    "audit:media": "tsx scripts/lib/audit-source-assets.ts",
    "typegen": "pnpm --filter @sorouh/studio typegen",
    "seed:sorouh": "pnpm --dir studio exec sanity exec ../scripts/seed-sorouh.ts --with-user-token --",
    "seo:expand:dry": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-seo-expansion.ts -- --dry-run",
    "seo:expand": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-seo-expansion.ts -- --apply",
    "seo:keyword-wave:dry": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-keyword-content-wave.ts -- --dry-run",
    "seo:keyword-wave": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-keyword-content-wave.ts -- --apply",
    "seo:editorial-wave:dry": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-editorial-content-wave.ts -- --dry-run",
    "seo:editorial-wave": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-editorial-content-wave.ts -- --apply",
    "seo:ahrefs-meta:dry": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-ahrefs-meta-remediation.ts -- --dry-run",
    "seo:ahrefs-meta": "pnpm --dir studio exec sanity exec --with-user-token ../scripts/apply-ahrefs-meta-remediation.ts -- --apply",
    "seo:indexnow:dry": "tsx scripts/submit-indexnow.ts --dry-run",
    "seo:indexnow": "tsx scripts/submit-indexnow.ts --apply",
    "media:semantic": "pnpm --dir studio exec sanity exec ../scripts/apply-semantic-media.ts --with-user-token --",
    "bootstrap:client": "pnpm --dir studio exec sanity exec ../scripts/bootstrap-client.ts --with-user-token"
  },
  "devDependencies": {
    "@portabletext/markdown": "2.1.0",
    "@sanity/client": "8.6.1",
    "@types/node": "26.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sanity": "6.13.1",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.2"
  }
}
