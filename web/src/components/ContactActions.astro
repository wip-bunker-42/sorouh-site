---
import { contactLinks } from '../lib/phone'
import { contactContextForPath } from '../lib/contact-context'
import { loadSnapshot } from '../lib/content/load-snapshot'
type Props = {
  primary: string
  backup?: string
  location: string
  light?: boolean
  compact?: boolean
  action?: 'call' | 'whatsapp'
  label?: string
}
const {
  primary,
  backup,
  location,
  light = false,
  compact = false,
  action = 'whatsapp',
  label,
} = Astro.props
const contactContext = contactContextForPath(Astro.url.pathname, loadSnapshot())
const first = contactLinks(primary, contactContext.message)
const second = backup ? contactLinks(backup) : null
const preferredHref = action === 'call' ? first.tel : first.whatsapp
const alternateHref = action === 'call' ? first.whatsapp : first.tel
---

<div class:list={['actions', { compact }]}>
  <a
    class="btn btn-primary"
    href={preferredHref}
    data-contact
    data-contact-type={action}
    data-contact-location={location}
    aria-label={label ?? (action === 'call' ? 'اتصل بنا' : 'تواصل معنا عبر واتساب')}
    >{label ?? (action === 'call' ? 'اتصل الآن' : 'واتساب')}</a
  >
  <a
    class:list={['btn', light ? 'btn-light' : 'btn-ghost']}
    href={alternateHref}
    data-contact
    data-contact-type={action === 'call' ? 'whatsapp' : 'call'}
    data-contact-location={location}>{action === 'call' ? 'واتساب' : 'اتصل الآن'}</a
  >
  {
    second && compact && (
      <a
        class:list={['btn backup', light ? 'btn-light' : 'btn-ghost']}
        href={second.tel}
        data-contact
        data-contact-type="call"
        data-contact-location={location}
      >
        الرقم الاحتياطي
      </a>
    )
  }
</div>
<style>
  .compact {
    margin-top: 0.6rem;
  }
  .compact .btn {
    min-height: 43px;
    padding: 0.45rem 0.9rem;
    font-size: 0.88rem;
  }
  .backup {
    opacity: 0.86;
  }
</style>
