{
  "name": "@sorouh/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "check": "pnpm check:types && pnpm check:schema && pnpm test",
    "check:types": "tsc --noEmit",
    "check:schema": "sanity schemas validate",
    "test": "vitest run --root .. studio/src/tests",
    "typegen": "sanity schemas extract --enforce-required-fields --path ../web/src/sanity/schema.json --force && sanity typegen generate",
    "deploy": "sanity deploy",
    "deploy:ci": "sanity deploy --yes --schema-required"
  },
  "dependencies": {
    "@sanity/client": "8.6.1",
    "@sanity/icons": "5.2.2",
    "@sanity/ui": "4.2.1",
    "@sanity/vision": "6.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.13.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
