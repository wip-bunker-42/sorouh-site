---
const { items } = Astro.props as { items: Array<{ question: string; answer: string }> }
---

<div class="faq-list">
  {
    items.map((item) => (
      <details>
        <>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </>
      </details>
    ))
  }
</div>
