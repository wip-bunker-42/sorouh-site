---
import { getPortableLinkAttributes, type PortableLinkNode } from '../../lib/portable-link'

const { href, external } = getPortableLinkAttributes(
  (Astro.props as { node?: PortableLinkNode }).node,
)
---

<a
  {href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}><slot /></a
>
