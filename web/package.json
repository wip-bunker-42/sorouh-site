{
  "name": "@sorouh/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/prepare-build.ts && astro build && tsx scripts/validate-dist.ts",
    "preview": "astro preview",
    "check": "pnpm check:types && pnpm test",
    "check:types": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:build": "pnpm build && vitest run tests/integration/build.test.ts",
    "validate:dist": "tsx scripts/validate-dist.ts",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@portabletext/types": "4.0.2",
    "@sanity/client": "8.10.0",
    "@sanity/image-url": "2.1.1",
    "astro": "7.4.1",
    "astro-portabletext": "1.0.1",
    "github-slugger": "2.0.0",
    "groq": "6.20.0",
    "schema-dts": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "cheerio": "1.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.2"
  }
}
