---
import SanityImage from './media/SanityImage.astro'
type Props = { image: any; width?: number; ratio?: number; priority?: boolean; class?: string }
const { image, width = 1200, ratio = 16 / 10, priority = false, class: className } = Astro.props
---

{
  image?.asset && (
    <figure class:list={['content-image', { 'has-caption': image.caption }]}>
      <SanityImage
        image={image}
        alt={image.alt}
        width={width}
        aspectRatio={ratio}
        priority={priority}
        class={className}
      />
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>
  )
}

<style>
  .content-image {
    display: grid;
    margin: 0;
    width: 100%;
    height: 100%;
  }
  .content-image :global(img) {
    min-width: 0;
  }
  .content-image.has-caption {
    grid-template-rows: minmax(0, 1fr) auto;
  }
  figcaption {
    padding: 0.55rem 0.75rem;
    color: var(--muted);
    background: color-mix(in srgb, white 94%, var(--copper));
    font-size: 0.76rem;
    line-height: 1.55;
  }
</style>
