---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactActions from '../components/ContactActions.astro'
import ContentImage from '../components/ContentImage.astro'
import ListingCard from '../components/ListingCard.astro'
import FaqList from '../components/FaqList.astro'
import PortableContent from '../components/PortableContent.astro'
import { loadSnapshot } from '../lib/content/load-snapshot'
const data = loadSnapshot(),
  home = data.homePage,
  settings = data.siteSettings
const indexableServices = data.services.filter((service) => !service.seo.noIndex)
const indexableProjects = data.projects.filter((project) => !project.seo.noIndex)
const featuredServices = (home.featuredServices ?? [])
  .map((reference: any) => indexableServices.find((service) => service._id === reference._id))
  .filter(Boolean)
const displayedServices = featuredServices.length ? featuredServices : indexableServices.slice(0, 7)
const selectedProjects = (home.featuredProjects ?? [])
  .map((reference: any) => indexableProjects.find((project) => project._id === reference._id))
  .filter(Boolean)
const featuredProjects = (
  selectedProjects.length
    ? selectedProjects
    : indexableProjects.filter((project) => project.featured)
).slice(0, 4)
const faqs = [
  {
    question: 'ما الخدمات التي تنفذها صروح الشرقية؟',
    answer:
      'ننفذ المقاولات العامة والبناء والترميم والتشطيب واللياسة والقص والكور والكهرباء والسباكة والدهانات والبورسلان والجبس بورد.',
  },
  {
    question: 'ما المدن التي تغطيها خدماتكم؟',
    answer:
      'نخدم الدمام والخبر والظهران والقطيف والجبيل وسيهات والأحساء ورأس تنورة وبقيق ومختلف مدن المنطقة الشرقية.',
  },
  {
    question: 'كيف أبدأ طلب المعاينة؟',
    answer:
      'تواصل عبر واتساب أو الاتصال على الرقم الأساسي وأرسل نوع العمل ومدينة المشروع، وسنرتب الخطوة التالية.',
  },
]
---

<BaseLayout
  title={home.seo.metaTitle}
  description={home.seo.metaDescription}
  path="/"
  image={home.seo.shareImage?.asset?.url}
  noIndex={home.seo.noIndex}
  canonicalOverride={home.seo.canonicalOverride}
>
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{home.heroEyebrow}</p><h1>{home.heroTitle}</h1><p>
          {home.heroSummary}
        </p><ContactActions primary={settings.primaryPhone} location="hero" />
      </div><div class="hero-media">
        <ContentImage image={home.heroImage} width={1000} ratio={4 / 5} priority /><span
          >تنفيذ في المنطقة الشرقية</span
        >
      </div>
    </div>
  </section>
  <section class="stats">
    <div class="container stats-grid">
      {
        settings.stats.map((stat: any, index: number) => (
          <div>
            <>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
              <i>0{index + 1}</i>
            </>
          </div>
        ))
      }
    </div>
  </section>
  <section class="section home-introduction">
    <div class="narrow"><PortableContent value={home.introduction} /></div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">خدمات متكاملة</p><h2>
            كل مرحلة تحتاج تنفيذًا يعرف ما قبلها وما بعدها
          </h2>
        </div><p>نرتب البنود بحيث تعمل فرق البناء والخدمات والتشطيبات ضمن مسار واحد واضح.</p>
      </div><div class="service-strips">
        {
          displayedServices.map((service: any, index: number) => (
            <a href={`/الخدمات/${service.slug}/`}>
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
                <b>←</b>
              </>
            </a>
          ))
        }
      </div><a class="text-link" href="/الخدمات/">عرض جميع الخدمات ←</a>
    </div>
  </section>
  <section class="section projects">
    <div class="container">
      <p class="eyebrow">من موقع العمل</p><h2>مشاريع تتحدث بالتفاصيل</h2><div class="project-grid">
        {
          featuredProjects.map((project: any) => (
            <ListingCard
              href={`/مشاريعنا/${project.slug}/`}
              title={project.title}
              summary={project.summary}
              image={project.gallery?.[0]}
              eyebrow={`${project.serviceArea?.title} • ${project.classification}`}
            />
          ))
        }
      </div>
    </div>
  </section>
  <section class="section process">
    <div class="container process-grid">
      <div>
        <p class="eyebrow">طريقة العمل</p><h2>وضوح قبل التنفيذ، ومراجعة قبل التسليم</h2><p
          class="lead"
        >
          لا نبدأ من منتصف القصة. نفهم الموقع والنطاق ثم نرتب الاعتماد بين الأعمال ونراجع النتيجة
          على مراحل.
        </p>
      </div><ol>
        <li>
          <b>01</b><div>
            <h3>معاينة وفهم الاحتياج</h3><p>نحدد الحالة الحالية والهدف وحدود العمل.</p>
          </div>
        </li><li>
          <b>02</b><div><h3>خطة ونطاق واضح</h3><p>نرتب البنود والتوريد ونقاط الفحص.</p></div>
        </li><li>
          <b>03</b><div>
            <h3>تنفيذ ومتابعة</h3><p>نتابع التفاصيل ونمنع إغلاق أي بند قبل مراجعته.</p>
          </div>
        </li><li>
          <b>04</b><div><h3>تسليم منظم</h3><p>نراجع التشغيل والتشطيب والملاحظات النهائية.</p></div>
        </li>
      </ol>
    </div>
  </section>
  <section class="section areas">
    <div class="container areas-grid">
      <div>
        <p class="eyebrow">نصل إليك</p><h2>مقاولات في مدن المنطقة الشرقية</h2><p>
          فرقنا تخدم المشاريع السكنية في المدن الرئيسية والمناطق المحيطة بها.
        </p><ContactActions primary={settings.primaryPhone} location="home_areas" light />
      </div><div class="area-links">
        {
          data.areas
            .filter((area) => !area.seo.noIndex)
            .map((area) => (
              <a href={`/مناطق-الخدمة/${area.slug}/`}>
                {area.title}
                <span>←</span>
              </a>
            ))
        }
      </div>
    </div>
  </section>
  <section class="section">
    <div class="narrow">
      <p class="eyebrow">أسئلة شائعة</p><h2>إجابات مباشرة قبل أن تبدأ</h2><FaqList items={faqs} />
    </div>
  </section>
  <section class="section-sm posts">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">دليل المشروع</p><h2>مقالات عملية قبل اتخاذ القرار</h2></div><a
          href="/المدونة/">جميع المقالات ←</a
        >
      </div><div class="grid grid-3">
        {
          data.posts
            .filter((post) => !post.seo.noIndex)
            .slice(0, 3)
            .map((post) => (
              <ListingCard
                href={`/المدونة/${post.slug}/`}
                title={post.title}
                summary={post.excerpt}
                image={post.featuredImage}
                eyebrow={post.category?.title}
              />
            ))
        }
      </div>
    </div>
  </section>
  <section class="final">
    <div class="container">
      <p class="eyebrow">{settings.availability}</p><h2>{home.closingCta.headline}</h2><p>
        {home.closingCta.body}
      </p><ContactActions
        primary={settings.primaryPhone}
        backup={settings.backupPhone}
        location="home_end"
        action={home.closingCta.action}
        label={home.closingCta.label}
      />
    </div>
  </section>
</BaseLayout>
<style>
  .home-hero {
    overflow: hidden;
    color: white;
    background: var(--navy-950);
    padding: clamp(3.5rem, 7vw, 7rem) 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
  }
  .hero-copy h1 {
    color: white;
    font-size: clamp(2.6rem, 5.5vw, 5.2rem);
    max-width: 14ch;
  }
  .hero-copy > p:not(.eyebrow) {
    color: #c8d4de;
    font-size: 1.13rem;
    max-width: 58ch;
  }
  .hero-media {
    position: relative;
    transform: rotate(-2deg);
    padding: 1rem;
    background: #fff;
    border-radius: 2px;
    box-shadow: var(--shadow);
  }
  .hero-media :global(img) {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
  }
  .hero-media span {
    position: absolute;
    right: -1.5rem;
    bottom: 2.5rem;
    padding: 0.6rem 1rem;
    background: var(--copper);
    color: #16120e;
    font-weight: 850;
  }
  .stats {
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stats-grid > div {
    position: relative;
    padding: 2.2rem 1.2rem;
    border-left: 1px solid var(--line);
  }
  .stats strong,
  .stats span {
    display: block;
  }
  .stats strong {
    color: var(--navy-950);
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1.2;
  }
  .stats span {
    color: var(--muted);
  }
  .stats i {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: #65717d;
    font-style: normal;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2.2rem;
  }
  .section-head > p {
    max-width: 44ch;
    color: var(--muted);
  }
  .service-strips {
    border-top: 1px solid var(--line);
  }
  .service-strips a {
    display: grid;
    grid-template-columns: 60px minmax(180px, 0.7fr) 1.3fr 30px;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.2s;
  }
  .service-strips a:hover {
    background: #fff;
  }
  .service-strips span {
    color: var(--copper);
    font-weight: 850;
  }
  .service-strips h3 {
    margin: 0;
  }
  .service-strips p {
    color: var(--muted);
  }
  .text-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: #99440c;
    font-weight: 850;
  }
  .projects {
    background: #ede8e0;
  }
  .project-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 1rem;
  }
  .project-grid :global(.listing:first-child) {
    grid-row: span 3;
  }
  .project-grid :global(.listing:first-child .visual) {
    aspect-ratio: 1;
  }
  .process {
    background: white;
  }
  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }
  .process ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .process li {
    display: flex;
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .process li > b {
    color: var(--copper);
    font-size: 1.4rem;
  }
  .process h3,
  .process p {
    margin: 0.1rem 0;
  }
  .areas {
    color: white;
    background: var(--navy-900);
  }
  .areas h2 {
    color: white;
  }
  .areas p {
    color: #c7d3dd;
  }
  .areas-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5rem;
  }
  .area-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .area-links a {
    display: flex;
    justify-content: space-between;
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    text-decoration: none;
  }
  .area-links span {
    color: var(--copper-bright);
  }
  .posts {
    background: white;
  }
  .final {
    padding: clamp(4rem, 9vw, 8rem) 0;
    color: white;
    background: linear-gradient(120deg, var(--navy-950) 60%, #773812);
  }
  .final h2 {
    color: white;
    max-width: 14ch;
  }
  .final p {
    max-width: 60ch;
    color: #d7e0e7;
  }
  @media (max-width: 820px) {
    .hero-grid,
    .process-grid,
    .areas-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      max-width: 420px;
      margin: auto;
    }
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .project-grid :global(.listing:first-child) {
      grid-row: auto;
    }
    .section-head {
      display: block;
    }
    .service-strips a {
      grid-template-columns: 40px 1fr 25px;
    }
    .service-strips p {
      display: none;
    }
    .area-links {
      grid-template-columns: 1fr;
    }
  }
</style>
