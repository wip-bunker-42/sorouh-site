---
import { PortableText } from 'astro-portabletext'
import PortableCta from './portable/PortableCta.astro'
import PortableHeading2 from './portable/PortableHeading2.astro'
import PortableHeading3 from './portable/PortableHeading3.astro'
import PortableImage from './portable/PortableImage.astro'
import PortableLink from './portable/PortableLink.astro'
import PortableYouTube from './portable/PortableYouTube.astro'
import { preparePortableText, type PortableNode } from '../lib/portable-text'

const { value = [] } = Astro.props as { value?: PortableNode[] }
const prepared = preparePortableText(value)
const components = {
  type: {
    contentImage: PortableImage,
    cta: PortableCta,
    youtubeVideo: PortableYouTube,
  },
  block: {
    h2: PortableHeading2,
    h3: PortableHeading3,
  },
  mark: {
    link: PortableLink,
  },
}
---

<div class="prose"><PortableText value={prepared} {components} /></div>
